# Copy to .secrets.env and replace placeholders locally. Raw env-file syntax:
# use literal values without shell quotes, including passwords containing $.
WYZE_EMAIL=YOUR_WYZE_ACCOUNT_EMAIL
WYZE_PASSWORD=YOUR_WYZE_SPECIFIC_PASSWORD
WYZE_API_ID=YOUR_WYZE_DEVELOPER_API_ID
WYZE_API_KEY=YOUR_WYZE_DEVELOPER_API_KEY
BRIDGE_PASSWORD=GENERATE_A_RANDOM_LOCAL_BRIDGE_PASSWORD
STREAM_AUTH=localviewer:GENERATE_A_RANDOM_LOCAL_STREAM_PASSWORD
# These are camera API identifiers, not just the physical MAC address.
FILTER_MACS=GW_GC1_REPLACE_WITH_DEVICE_SUFFIX
GWELL_LAN_IPS=GW_GC1_REPLACE_WITH_DEVICE_SUFFIX=REPLACE_WITH_CAMERA_LAN_IP
